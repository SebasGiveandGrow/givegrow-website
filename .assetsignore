# Qué NO se sube como asset público del Worker.
# Sintaxis tipo .gitignore. Verificado el 8 ago 2026: sin las entradas de abajo,
# https://www.thegiveandgrowproject.org/SESSION_HANDOFF.md servía 48 KB de notas
# internas de trabajo, y /.wrangler/cache/cf.json filtraba la ciudad y el
# proveedor de red de la máquina que hizo el último `wrangler dev`.
#
# `_headers` NO va aquí: Cloudflare ya lo excluye solo (verificado) y ponerlo
# arriesgaría que deje de procesarse, y con él se iría la CSP.
#
# Se sirve, a propósito: index.html, app.js, styles.css, favicon.svg,
# manifest.webmanifest, robots.txt, sitemap.xml, img/, vendor/, docs/, data/,
# i18n/ y .well-known/.

# El repositorio entero. Verificado el 10 ago 2026: /.git/HEAD, /.git/config y
# /.git/index respondían con contenido real en producción, así que cualquiera
# podía reconstruir el repositorio con toda su historia. El repo ya es público en
# GitHub —así que no se filtraba nada confidencial y ningún secreto se commiteó
# nunca— pero es superficie innecesaria, y el día que el repo se vuelva privado o
# alguien commitee algo sensible, deja de ser inofensivo.
# Además era la mayor parte de los 2.874 archivos de cada despliegue.
.git

# Código y configuración del despliegue
worker.js
documentos.js
wrangler.toml
package.json
package-lock.json
node_modules
.wrangler

# Automatizaciones y utilidades internas
ops
scripts
.github
.claude

# Documentación de trabajo (el marco público vive en el sitio, no en estos .md)
*.md
.clauderules

# Meta del repositorio
.assetsignore
.gitignore
.DS_Store
